# ============================================================
# FRD 金融反欺诈系统 - 环境变量模板
# 复制为 .env 并填写实际值，切勿提交 .env 到版本库。
# 安全提示：docker-compose.yml 对数据服务强制 ${VAR:?}，
# 未设置将拒绝启动；APP_ENV=prod 时 app/config.py 会校验
# 弱密钥（change-me-* / frd_dev_password / test12345 等）直接报错。
# ============================================================

# ---- 应用 ----
APP_ENV=local                      # local | dev | test | staging | prod
APP_NAME=frd
APP_PORT=8000
APP_LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR
APP_SECRET_KEY=change-me-to-a-long-random-string

# ---- PostgreSQL ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=frd
POSTGRES_USER=frd
POSTGRES_PASSWORD=frd_dev_password
POSTGRES_POOL_SIZE=10
POSTGRES_MAX_OVERFLOW=20

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ---- Neo4j ----
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=frd_neo4j_password
NEO4J_DATABASE=neo4j

# ---- Kafka (本地可选，dev 用 Redis 替代) ----
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_TRANSACTIONS=frd.transactions
KAFKA_TOPIC_DECISIONS=frd.decisions
KAFKA_TOPIC_AUDIT=frd.audit_log
KAFKA_CONSUMER_GROUP=frd-scoring

# ---- Celery ----
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ---- JWT / 认证 ----
JWT_SECRET_KEY=change-me-to-a-different-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- Tokenization (PCI-DSS) ----
TOKENIZATION_PROVIDER=local        # local | aliyun-kms
TOKENIZATION_LOCAL_KEY=change-me-32-bytes-hex-key
# 阿里云 KMS（生产用）
ALIYUN_KMS_KEY_ID=
ALIYUN_KMS_ACCESS_KEY_ID=
ALIYUN_KMS_ACCESS_KEY_SECRET=
ALIYUN_KMS_REGION=cn-hangzhou

# ---- LLM (PIPL 数据本地化，国内 API) ----
LLM_PROVIDER=deepseek              # qwen | deepseek
QWEN_API_KEY=
QWEN_MODEL=qwen-max
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# ---- 评分参数 (D03 V1.1 §4.1) ----
SCORING_P99_BUDGET_MS=200
SCORING_CACHE_TTL_SECONDS=300
SCORING_MODALITY_TIMEOUT_MS=30
SCORING_SHAP_CACHE_HOURS=24

# ---- Kill Switch (D03 V1.1 §4.8) ----
KILL_SWITCH_GLOBAL=false
KILL_SWITCH_ML=false
KILL_SWITCH_RULES=false
KILL_SWITCH_GNN=false

# ---- CORS ----
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- 可观测性 ----
PROMETHEUS_ENABLED=true
JAEGER_ENDPOINT=http://localhost:14268/api/traces
SENTRY_DSN=

# ---- 对象存储 (阿里云 OSS，生产用) ----
OSS_BUCKET=
OSS_REGION=cn-hangzhou
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
