# FRD 前端环境变量样例
# 复制为 .env 并按实际环境填写
#
# 推荐保持 VITE_API_BASE_URL 为相对路径（/api/v1），由 vite dev server 代理转发，
# 避免绝对地址绕过代理导致 CORS/端口不一致问题。

# API 基础地址（默认走 vite 代理；仅在直连后端时改为绝对地址）
VITE_API_BASE_URL=/api/v1

# WebSocket 端点（用于 SHAP/报表/PIPL 异步事件推送；本地开发默认 8002）
VITE_WS_BASE_URL=ws://localhost:8002/api/v1/ws

# vite dev 代理目标（容器内应指向服务名，如 http://backend:8000）
VITE_PROXY_TARGET=http://localhost:8002

# 应用标题
VITE_APP_TITLE=FRD 金融反欺诈系统

# PWA 启用开关
VITE_PWA_ENABLED=true
