{
  "name": "frd-frontend",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "FRD 金融反欺诈系统前端 (Vue 3.5 + TS + Vite 6)",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint src --ext .vue,.ts,.tsx --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "vue": "^3.5.0",
    "vue-router": "^4.4.0",
    "pinia": "^2.2.0",
    "element-plus": "^2.8.0",
    "@element-plus/icons-vue": "^2.3.1",
    "axios": "^1.7.0",
    "echarts": "^5.5.0",
    "vue-echarts": "^7.0.3",
    "vis-network": "^9.1.0",
    "vis-data": "^7.1.0",
    "@vueuse/core": "^11.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.1.0",
    "vite": "^6.0.0",
    "vue-tsc": "^2.1.0",
    "typescript": "^5.6.0",
    "vite-plugin-pwa": "^1.0.0",
    "unplugin-auto-import": "^0.18.0",
    "unplugin-vue-components": "^0.27.0",
    "sass": "^1.78.0",
    "@types/node": "^22.5.0",
    "vitest": "^3.0.0",
    "@vitest/coverage-v8": "^4.1.11",
    "jsdom": "^25.0.0",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.14.0",
    "@eslint/js": "^9.14.0",
    "eslint-plugin-vue": "^9.31.0",
    "typescript-eslint": "^8.14.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
